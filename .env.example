# Supabase — use the NEW publishable key (sb_publishable_...) in the cloud.
# For local dev, use the key printed by `supabase start`.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Sentry (browser-safe DSN)
VITE_SENTRY_DSN=

# App environment: `stage` on Netlify previews, `production` in the CI deploy build, empty locally
# (reads as "development"). It sets the Sentry environment and picks the feature-flag column in
# src/lib/features.ts.
VITE_APP_ENV=
